ty":1,"message":"136","line":170,"column":37,"nodeType":"134","endLine":172,"endColumn":68},{"ruleId":"124","replacedBy":"140"},{"ruleId":"126","replacedBy":"141"},"no-native-reassign",["142"],"no-negated-in-lhs",["143"],["142"],["143"],["142"],["143"],"react/jsx-pascal-case","Imported JSX component select must be in PascalCase or SCREAMING_SNAKE_CASE","JSXOpeningElement","Imported JSX component text must be in PascalCase or SCREAMING_SNAKE_CASE","Imported JSX component textarea must be in PascalCase or SCREAMING_SNAKE_CASE",["142"],["143"],"Imported JSX component checkbox must be in PascalCase or SCREAMING_SNAKE_CASE",["142"],["143"],"no-global-assign","no-unsafe-negation"]